{
  "enabledPlugins": {
    "workflow@skills-dir": true,
    "workflow@inline": false,
    "claude-seo@agricidaniel-claude-seo": true
  },
  "autoMemoryEnabled": false,
  "autoCompactWindow": 200000,
  "permissions": {
    "ask": [
      "Bash(git reset --hard)",
      "Bash(git reset --hard *)",
      "Bash(git push --force)",
      "Bash(git push --force *)",
      "Bash(git push -f)",
      "Bash(git push -f *)",
      "Bash(git branch -D)",
      "Bash(git branch -D *)",
      "Bash(git branch -d)",
      "Bash(git branch -d *)",
      "Bash(git stash drop)",
      "Bash(git stash drop *)",
      "Bash(git rebase -i)",
      "Bash(git rebase -i *)"
    ]
  },
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "haiku"
  }
}
