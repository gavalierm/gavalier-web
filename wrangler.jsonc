{
  // Statický web gavalier.sk bez Worker skriptu: Cloudflare servíruje súbory z koreňa repozitára.
  // Čo sa nenahrá, určuje .assetsignore. Postup a rozhodnutie: docs/cloudflare-hosting.md
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gavalier-web",
  "compatibility_date": "2026-11-11",
  "assets": {
    "directory": "./",
    // /blog/ -> blog/index.html a /blog -> /blog/ (predvolená hodnota, uvedená výslovne)
    "html_handling": "auto-trailing-slash",
    // Neznáma adresa vráti stav 404 a najbližší súbor 404.html (vlastná stránka)
    "not_found_handling": "404-page"
  }
}
